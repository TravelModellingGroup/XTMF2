<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:XTMF2.GUI.Resources"
        x:Class="XTMF2.GUI.Views.InputDialog"
        x:CompileBindings="False"
        Width="400"
        Height="150"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    
    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        
        <!-- Prompt Text -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Prompt}"
                   FontSize="14"
                   Margin="0,0,0,15"
                   TextWrapping="Wrap"/>
        
        <!-- Input TextBox -->
        <TextBox Grid.Row="1"
                 x:Name="InputTextBox"
                 Text="{Binding InputText}"
                 Watermark="{res:Localize Dialog_EnterText}"
                 VerticalAlignment="Top"/>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,15,0,0">
            <Button Content="{res:Localize Dialog_OK}"
                    Click="OK_Click"
                    IsDefault="True"
                    Padding="20,8"
                    MinWidth="80"/>
            <Button Content="{res:Localize Dialog_Cancel}"
                    Click="Cancel_Click"
                    IsCancel="True"
                    Padding="20,8"
                    MinWidth="80"/>
        </StackPanel>
        
    </Grid>
    
</Window>
