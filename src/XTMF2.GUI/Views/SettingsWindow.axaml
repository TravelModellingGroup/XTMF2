<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:XTMF2.GUI.Resources"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="360"
        x:Class="XTMF2.GUI.Views.SettingsWindow"
        x:CompileBindings="True"
        Classes="neon-dialog"
        Title="{res:Localize Settings_Title}"
        Width="600"
        Height="360"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        KeyUp="Window_KeyUp"
        >

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{res:Localize Settings_Title}"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource DlgAccent}"/>
            <TextBlock Text="{res:Localize Settings_Subtitle}"
                       FontSize="11"
                       Opacity="0.6"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0"/>
        </StackPanel>
        
        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Spacing="16">
                
                <!-- General Section -->
                <Border BorderBrush="{DynamicResource DlgListBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="15">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{res:Localize Settings_General}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DlgAccent}"
                                   Margin="0,0,0,5"/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="{res:Localize Settings_Theme}"
                                       FontWeight="SemiBold"/>
                            <ComboBox x:Name="ThemeComboBox"
                                      Width="300"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Content="{res:Localize Settings_ThemeDark}" Tag="Dark"/>
                                <ComboBoxItem Content="{res:Localize Settings_ThemeLight}" Tag="Light"/>
                            </ComboBox>
                        </StackPanel>
                        
                        <StackPanel Spacing="8">
                            <TextBlock Text="{res:Localize Settings_Language}"
                                       FontWeight="SemiBold"/>
                            <ComboBox x:Name="LanguageComboBox"
                                      Width="300"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="LanguageComboBox_SelectionChanged">
                                <ComboBoxItem Content="{res:Localize Settings_LanguageEnglish}" Tag="en"/>
                                <ComboBoxItem Content="{res:Localize Settings_LanguageFrench}" Tag="fr"/>
                                <ComboBoxItem Content="{res:Localize Settings_LanguageSpanish}" Tag="es"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Runtime Section -->
                <Border BorderBrush="{DynamicResource DlgListBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="15">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{res:Localize Settings_Runtime}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DlgAccent}"
                                   Margin="0,0,0,5"/>
                        
                        <CheckBox Content="{res:Localize Settings_PlaySystemSounds}"
                                  x:Name="PlaySystemSoundsCheckBox"/>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </ScrollViewer>
        
        <!-- Footer Buttons -->
        <Border Grid.Row="2"
            BorderBrush="{DynamicResource DlgSep}"
            BorderThickness="0,1,0,0"
            Margin="0,8,0,0"
            Padding="0,8,0,0">
            <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="10">
            <Button Classes="dlg-primary"
                Content="{res:Localize Dialog_OK}"
                Click="Save_Click"
                Width="100"/>
            <Button Content="{res:Localize Dialog_Cancel}"
                Click="Cancel_Click"
                Width="100"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
