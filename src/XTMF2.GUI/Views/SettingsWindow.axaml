<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:XTMF2.GUI.Resources"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
        x:Class="XTMF2.GUI.Views.SettingsWindow"
        Title="{res:Localize Settings_Title}"
        Width="600"
        Height="450"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        KeyUp="Window_KeyUp"
        >
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{res:Localize Settings_Title}"
                       FontSize="24"
                       FontWeight="Bold"/>
            <TextBlock Text="{res:Localize Settings_Subtitle}"
                       FontSize="12"
                       Opacity="0.7"
                       Margin="0,5,0,0"/>
        </StackPanel>
        
        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" Margin="0,0,0,20">
            <StackPanel Spacing="20">
                
                <!-- General Section -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="15">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{res:Localize Settings_General}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>
                        
                        <StackPanel Spacing="8">
                            <TextBlock Text="{res:Localize Settings_DefaultUser}"
                                       FontWeight="SemiBold"/>
                            <TextBox x:Name="DefaultUserTextBox"
                                     Watermark="{res:Localize Settings_DefaultUserWatermark}"
                                     Width="300"
                                     HorizontalAlignment="Left"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="8">
                            <TextBlock Text="{res:Localize Settings_Theme}"
                                       FontWeight="SemiBold"/>
                            <ComboBox x:Name="ThemeComboBox"
                                      Width="300"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Content="{res:Localize Settings_ThemeDark}" Tag="Dark"/>
                                <ComboBoxItem Content="{res:Localize Settings_ThemeLight}" Tag="Light"/>
                                <ComboBoxItem Content="{res:Localize Settings_ThemeForestGreen}" Tag="ForestGreen"/>
                                <ComboBoxItem Content="{res:Localize Settings_ThemeRubyRed}" Tag="RubyRed"/>
                                <ComboBoxItem Content="{res:Localize Settings_ThemeSapphireBlue}" Tag="SapphireBlue"/>
                            </ComboBox>
                        </StackPanel>
                        
                        <StackPanel Spacing="8">
                            <TextBlock Text="{res:Localize Settings_Language}"
                                       FontWeight="SemiBold"/>
                            <ComboBox x:Name="LanguageComboBox"
                                      Width="300"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="LanguageComboBox_SelectionChanged">
                                <ComboBoxItem Content="{res:Localize Settings_LanguageEnglish}" Tag="en"/>
                                <ComboBoxItem Content="{res:Localize Settings_LanguageFrench}" Tag="fr"/>
                                <ComboBoxItem Content="{res:Localize Settings_LanguageSpanish}" Tag="es"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Runtime Section -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="15">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{res:Localize Settings_Runtime}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>
                        
                        <CheckBox Content="{res:Localize Settings_VerboseLogging}"
                                  x:Name="VerboseLoggingCheckBox"/>
                        
                        <CheckBox Content="{res:Localize Settings_AutoSave}"
                                  x:Name="AutoSaveCheckBox"
                                  IsChecked="True"/>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </ScrollViewer>
        
        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">
            <Button Content="{res:Localize Dialog_OK}"
                    Click="Save_Click"
                    Padding="20,8"
                    Width="100"/>
            <Button Content="{res:Localize Dialog_Cancel}"
                    Click="Cancel_Click"
                    Padding="20,8"
                    Width="100"/>
            
        </StackPanel>
        
    </Grid>
    
</Window>
