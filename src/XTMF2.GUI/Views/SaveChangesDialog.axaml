<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:XTMF2.GUI.Resources"
        xmlns:local="clr-namespace:XTMF2.GUI.Views"
        x:Class="XTMF2.GUI.Views.SaveChangesDialog"
        x:CompileBindings="True"
        x:DataType="local:SaveChangesDialog"
        Classes="neon-dialog"
        Width="460"
        Height="170"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Window.Styles>
        <Style Selector="Button.save-choice">
            <Setter Property="Foreground" Value="{DynamicResource DlgFg}" />
        </Style>
        <Style Selector="Button.save-choice:focus">
            <Setter Property="Foreground" Value="{DynamicResource DlgPrimaryBtnFg}" />
            <Setter Property="Background" Value="{DynamicResource DlgPrimaryBtnBg}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="*,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="{Binding Message}" FontSize="14" Margin="0,0,0,15" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource DlgSep}"
                BorderThickness="0,1,0,0"
                Margin="0,8,0,0"
                Padding="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Name="YesButton" Content="{res:Localize Dialog_Yes}" Classes="save-choice" Click="Yes_Click" IsDefault="True" />
                <Button x:Name="NoButton" Content="{res:Localize Dialog_No}" Classes="save-choice" Click="No_Click" />
                <Button x:Name="CancelButton" Content="{res:Localize Dialog_Cancel}" Classes="save-choice" Click="Cancel_Click" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>