<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XTMF2.GUI.Views"
             x:Class="XTMF2.GUI.Views.CommandPaletteDropdown"
             x:DataType="local:CommandPaletteDropdown"
             x:CompileBindings="True">
    <Grid>
        <Popup x:Name="ActionPopup"
               IsLightDismissEnabled="True">
            <Border x:Name="PopupBorder"
                    Width="620"
                    MaxHeight="470"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource DlgBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="6">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <TextBox x:Name="SearchBox"
                             Grid.Row="0"
                             AutomationProperties.Name="Search editor commands"
                             Watermark="> Search commands"
                             FontSize="16"
                             Padding="10,8"
                             Margin="0,0,0,12"/>
                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,110,150"
                          ColumnSpacing="16"
                          Margin="10,4,10,8">
                        <TextBlock Text="Command"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Opacity="0.7"/>
                        <TextBlock Grid.Column="1"
                                   Text="Type"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Opacity="0.7"/>
                        <TextBlock x:Name="ShortcutHeader"
                                   Grid.Column="2"
                                   Text="Shortcut"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Opacity="0.7"
                                   HorizontalAlignment="Stretch"
                                   TextAlignment="Right"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="ActionList"
                                 ItemsSource="{Binding FilteredActions}"
                                 SelectionMode="Single"
                                 Padding="0"
                                 HorizontalAlignment="Stretch"
                                 MaxHeight="420"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:CommandPaletteAction">
                                    <Button Click="OnActionButtonClick"
                                            IsEnabled="{Binding IsEnabled}"
                                            ToolTip.Tip="{Binding DisplayName}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch">
                                        <Border Padding="10,8"
                                                HorizontalAlignment="Stretch"
                                                Opacity="{Binding VisualOpacity}">
                                            <Grid ColumnDefinitions="*,110,150"
                                                  ColumnSpacing="16"
                                                  HorizontalAlignment="Stretch">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding DisplayName}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding CommandType}"
                                                           IsVisible="{Binding HasCommandType}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Shortcut}"
                                                           IsVisible="{Binding HasShortcut}"
                                                           FontSize="11"
                                                           TextAlignment="Right"
                                                           HorizontalAlignment="Stretch"
                                                           Width="150"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="NoResultsText"
                                   Text="No matching actions"
                                   IsVisible="False"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.7"/>
                    </Grid>

                    <TextBlock Grid.Row="3"
                               Text="↑ ↓ Navigate    Enter Run    Esc Close"
                               FontSize="11"
                               Opacity="0.7"
                               HorizontalAlignment="Right"
                               Margin="0,10,2,0"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
