<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XTMF2.GUI.Views"
        xmlns:controls="clr-namespace:XTMF2.GUI.Controls"
        x:Class="XTMF2.GUI.Views.FunctionNodePickerDialog"
        x:CompileBindings="True"
        x:DataType="local:FunctionNodePickerDialog"
        Classes="neon-dialog"
        Width="620"
        Height="520"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">

    <Window.DataTemplates>
        <TreeDataTemplate DataType="local:FunctionNodePickerItem"
                          ItemsSource="{Binding Children}">
            <StackPanel Margin="2,1" Spacing="1">
                <TextBlock Text="{Binding DisplayName}"
                           FontSize="13"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Detail}"
                           IsVisible="{Binding IsNode}"
                           FontSize="11"
                           Opacity="0.6"/>
            </StackPanel>
        </TreeDataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">
        <TextBlock Grid.Row="0"
                   Text="{Binding Prompt}"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <controls:SearchBox Grid.Row="1"
                            x:Name="FilterBox"
                            Text="{Binding FilterText, Mode=TwoWay}"
                            Watermark="Search node, boundary, or type..."
                            Margin="0,0,0,8"
                            EnterPressed="FilterBox_EnterPressed"/>

        <Border Grid.Row="2" Classes="dlg-list" ClipToBounds="True">
            <Grid>
                <TreeView x:Name="CandidateTree"
                          ItemsSource="{Binding FilteredItems}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          IsVisible="{Binding HasResults}"
                          DoubleTapped="CandidateTree_DoubleTapped"
                          KeyDown="CandidateTree_KeyDown">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded}"/>
                        </Style>
                    </TreeView.Styles>
                </TreeView>

                <TextBlock Text="No function nodes match the current search."
                           IsVisible="{Binding !HasResults}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Opacity="0.5"
                           FontStyle="Italic"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,12,0,0">
            <Button Content="Select"
                    Classes="dlg-primary"
                    Click="Select_Click"
                    IsDefault="True"
                    IsEnabled="{Binding CanSelect}"
                    Padding="16,8"
                    MinWidth="80"/>
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    IsCancel="True"
                    Padding="16,8"
                    MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>
