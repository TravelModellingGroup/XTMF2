<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
        xmlns:vm="clr-namespace:XTMF2.GUI.ViewModels"
        x:Class="XTMF2.GUI.Views.AiAssistantWindow"
        x:DataType="vm:AiAssistantViewModel"
        x:CompileBindings="True"
        Classes="neon-dialog"
        Title="AI Assistant"
        Width="680"
        Height="760"
        MinWidth="520"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="Border.ai-prompt.ai-busy">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="Infinite"
                           PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.48"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="CheckBox.destructive">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Border.ai-surface">
            <Setter Property="Background" Value="#0CFFFFFF"/>
            <Setter Property="BorderBrush" Value="#2200D4FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Border.ai-composer">
            <Setter Property="Background" Value="#1200D4FF"/>
            <Setter Property="BorderBrush" Value="#7700D4FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="18" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,2">
            <StackPanel Spacing="2">
                <TextBlock Text="AI Assistant" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="{Binding ProviderId}" FontSize="11" Opacity="0.58"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Classes="dlg-icon" ToolTip.Tip="Start a new session"
                        Command="{Binding NewSessionCommand}"
                        IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="20" Height="20">
                            <Path Data="M 10,4 V 16 M 4,10 H 16"
                                  Stroke="{DynamicResource NeonIconPrimary}"
                                  StrokeThickness="2.2"
                                  StrokeLineCap="Round"
                                  Fill="Transparent"/>
                            <Ellipse Width="2.8"
                                     Height="2.8"
                                     Canvas.Left="8.6"
                                     Canvas.Top="8.6"
                                     Fill="{DynamicResource NeonIconSecondary}"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Classes="dlg-danger" Content="■" ToolTip.Tip="Cancel request"
                        Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Classes="ai-surface" Padding="10,8">
            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" ColumnSpacing="8">
                <TextBlock Text="Model" VerticalAlignment="Center" Opacity="0.7"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableModels}"
                          SelectedItem="{Binding ModelId, Mode=TwoWay}"
                      IsEditable="True" MinWidth="180"
                      MinHeight="34" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Mode" VerticalAlignment="Center" Opacity="0.7"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableModes}"
                          SelectedItem="{Binding Mode, Mode=TwoWay}"
                      MinWidth="120" MinHeight="34"
                      VerticalContentAlignment="Center"/>
                    <Button Grid.Column="4" Classes="dlg-icon"
                        ToolTip.Tip="Refresh models" Command="{Binding RefreshModelsCommand}"
                    IsEnabled="{Binding IsDiscoveringModels, Converter={x:Static BoolConverters.Not}}"
                    Width="34" Height="34" Padding="0" FontSize="22"
                    HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center">
                      <Viewbox Width="20" Height="20">
                        <Canvas Width="20" Height="20">
                            <Path Data="M 16,9 A 6,6 0 0 0 5,6"
                                Stroke="{DynamicResource NeonIconPrimary}"
                                StrokeThickness="1.8"
                                StrokeLineCap="Round"
                                Fill="Transparent"/>
                            <Path Data="M 5,3.5 V 6 H 7.5"
                                Stroke="{DynamicResource NeonIconSecondary}"
                                StrokeThickness="1.8"
                                StrokeLineCap="Round"
                                StrokeJoin="Round"
                                Fill="Transparent"/>
                            <Path Data="M 4,11 A 6,6 0 0 0 15,14"
                                Stroke="{DynamicResource NeonIconSecondary}"
                                StrokeThickness="1.8"
                                StrokeLineCap="Round"
                                Fill="Transparent"/>
                            <Path Data="M 15,16.5 V 14 H 12.5"
                                Stroke="{DynamicResource NeonIconPrimary}"
                                StrokeThickness="1.8"
                                StrokeLineCap="Round"
                                StrokeJoin="Round"
                                Fill="Transparent"/>
                        </Canvas>
                      </Viewbox>
                    </Button>
            </Grid>
        </Border>
        <Border Grid.Row="2" Classes="ai-surface" Padding="12,10">
            <ScrollViewer x:Name="ConversationScrollViewer" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Conversation" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.58"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="dlg-icon"
                                ToolTip.Tip="Copy latest response" Click="CopyResponse_Click"
                                IsEnabled="{Binding Response, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="20" Height="20">
                                    <Path Data="M 7,6 H 16 V 15 H 7 Z"
                                          Stroke="{DynamicResource NeonIconPrimary}"
                                          StrokeThickness="1.8"
                                          StrokeJoin="Round"
                                          Fill="Transparent"/>
                                    <Path Data="M 4,15 V 4 H 13"
                                          Stroke="{DynamicResource NeonIconSecondary}"
                                          StrokeThickness="1.8"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Conversation}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AiAssistantMessageViewModel">
                                <Grid Margin="0,2">
                                    <Border HorizontalAlignment="Right" MaxWidth="500"
                                            Padding="11,8" CornerRadius="8"
                                            Background="#3300D4FF"
                                            IsVisible="{Binding IsUser}">
                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap"/>
                                    </Border>
                                    <Border HorizontalAlignment="Left" MaxWidth="590"
                                            Padding="11,8" CornerRadius="8"
                                            Background="#0DFFFFFF"
                                            IsVisible="{Binding IsAssistant}">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Thinking..." FontWeight="SemiBold"
                                                       Opacity="0.58" IsVisible="{Binding HasThinking}"/>
                                            <TextBlock Text="{Binding Thinking}" TextWrapping="Wrap"
                                                       FontStyle="Italic" Opacity="0.58"
                                                       IsVisible="{Binding HasThinking}"/>
                                            <md:MarkdownScrollViewer Markdown="{Binding Content}"
                                                                     Loaded="MarkdownViewer_Loaded"
                                                                     IsVisible="{Binding IsMarkdownVisible}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Grid.Row="3" Classes="ai-surface" Padding="10" IsVisible="{Binding CanShowProposedActions}">
            <StackPanel Spacing="7">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="1">
                        <TextBlock Text="Review changes" FontWeight="SemiBold"/>
                        <TextBlock Text="Select the changes to apply" FontSize="11" Opacity="0.58"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="dlg-primary" Content="Apply"
                            Command="{Binding ApplyActionsCommand}" IsEnabled="{Binding CanApplyActions}"
                            Padding="14,6"/>
                </Grid>
                <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ProposedActions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplaySummary}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Classes.destructive="{Binding Proposal.IsDestructive}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Spacing="5">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding ModelContextSizeText}" FontSize="11" Opacity="0.5"/>
                    <TextBlock Text="{Binding LatestContextUsageText}" FontSize="11" Opacity="0.5"/>
                </StackPanel>
                <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding Error}" Foreground="#FF6680" TextWrapping="Wrap"/>
                </ScrollViewer>
                <Border Classes="ai-composer" Classes.ai-busy="{Binding IsBusy}" Padding="2">
                    <TextBox x:Name="PromptTextBox" Text="{Binding Prompt, Mode=TwoWay}"
                             Watermark="Ask a question or describe a change..."
                             AcceptsReturn="True" MinHeight="48" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
            <Button Grid.Column="1" Classes="dlg-primary" Content="➤" ToolTip.Tip="Send message"
                    Command="{Binding SendCommand}"
                    IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}"
                    VerticalAlignment="Bottom" Height="52" MinWidth="52" Padding="0"
                    FontSize="20" HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
