<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:XTMF2.GUI.Resources"
        xmlns:local="clr-namespace:XTMF2.GUI.Views"
        x:Class="XTMF2.GUI.Views.ConfirmDialog"
        x:CompileBindings="True"
        x:DataType="local:ConfirmDialog"
        Classes="neon-dialog"
        Width="400"
        Height="150"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    
    <Grid RowDefinitions="*,Auto" Margin="20">
        
        <!-- Message Text -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Message}"
                   FontSize="14"
                   Margin="0,0,0,15"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">
            <Button Content="{res:Localize Dialog_Yes}"
                    Classes="dlg-primary"
                    Click="Yes_Click"
                    IsDefault="True"
                    Padding="20,8"
                    MinWidth="80"/>
            <Button Content="{res:Localize Dialog_No}"
                    Click="No_Click"
                    IsCancel="True"
                    Padding="20,8"
                    MinWidth="80"/>
        </StackPanel>
        
    </Grid>
    
</Window>
