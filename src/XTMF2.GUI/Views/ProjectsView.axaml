<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:CompileBindings="True"
             xmlns:vm="clr-namespace:XTMF2.GUI.ViewModels"
             xmlns:controls="clr-namespace:XTMF2.GUI.Controls"
             xmlns:res="clr-namespace:XTMF2.GUI.Resources"
             xmlns:xtmf2="clr-namespace:XTMF2;assembly=XTMF2"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="XTMF2.GUI.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel"
             Classes="neon-view">
    
    <Grid RowDefinitions="Auto,*" Margin="10">
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{res:Localize Projects_Title}"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>
            <TextBlock x:Name="UserTextBlock"
                       FontSize="14"
                       Opacity="0.7"/>
        </StackPanel>
        
        <!-- Projects List -->
        <Border Grid.Row="1"
            Classes="dlg-list"
            Background="Transparent"
            Padding="0">
            
            <Grid RowDefinitions="Auto,*">
                
                <!-- Toolbar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource DlgInputBg}"
                        Padding="10,8"
                        BorderBrush="{DynamicResource DlgSep}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <StackPanel.Styles>
                                <Style Selector="Button.toolbar-icon">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="CornerRadius" Value="20"/>
                                    <Setter Property="Padding" Value="7,5"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="Width" Value="34"/>
                                    <Setter Property="Height" Value="30"/>
                                </Style>
                                <Style Selector="Button.toolbar-icon:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource DlgHover}"/>
                                </Style>
                                <Style Selector="Button.toolbar-icon:pressed /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource DlgAccentMid}"/>
                                </Style>
                            </StackPanel.Styles>
                            <Button Click="NewProject_Click"
                                    Classes="toolbar-icon"
                                    ToolTip.Tip="{res:Localize Projects_NewProject}">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M 10,4 V 16 M 4,10 H 16"
                                              Stroke="{DynamicResource NeonIconPrimary}"
                                              StrokeThickness="2.2"
                                              StrokeLineCap="Round"
                                              Fill="Transparent"/>
                                        <Ellipse Width="2.8"
                                                 Height="2.8"
                                                 Canvas.Left="8.6"
                                                 Canvas.Top="8.6"
                                                 Fill="{DynamicResource NeonIconSecondary}"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button Click="ImportProject_Click"
                                    Classes="toolbar-icon"
                                    ToolTip.Tip="{res:Localize Projects_Import}">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M 10,4 V 12 M 6.5,8.5 L 10,12 L 13.5,8.5"
                                              Stroke="{DynamicResource NeonIconPrimary}"
                                              StrokeThickness="1.9"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round"
                                              Fill="Transparent"/>
                                        <Path Data="M 4,13.5 V 16 H 16 V 13.5"
                                              Stroke="{DynamicResource NeonIconSecondary}"
                                              StrokeThickness="1.8"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round"
                                              Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                        <controls:SearchBox Grid.Column="2"
                                           x:Name="ProjectSearchBox"
                                           Text="{Binding SearchText, Mode=TwoWay}"
                                           Watermark="{res:Localize Projects_SearchPlaceholder}"
                                           Width="275"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           EnterPressed="SearchBox_EnterPressed"/>
                    </Grid>
                </Border>
                
                <!-- Projects DataGrid -->
                <ScrollViewer Grid.Row="1" Background="Transparent">
                    <ListBox ItemsSource="{Binding FilteredProjects}" Background="Transparent">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="3"/>
                                <Setter Property="CornerRadius" Value="6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                            <Style Selector="ListBoxItem /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource DlgHover}"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource DlgSelected}"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource DlgSelected}"/>
                            </Style>
                            <Style Selector="ListBoxItem > Border.project-row">
                                <Setter Property="CornerRadius" Value="6"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource DlgSep}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover > Border.project-row">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected > Border.project-row">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected:pointerover > Border.project-row">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="xtmf2:Project">
                                <Border Classes="project-row"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource DlgSep}"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,10"
                                        Cursor="Hand"
                                        DoubleTapped="Border_DoubleTapped">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{res:Localize Projects_Open}"
                                                      Click="OpenProject_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="→" FontSize="11" VerticalAlignment="Center"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{res:Localize Projects_Rename}"
                                                      Click="RenameProject_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="✏" FontSize="11" VerticalAlignment="Center"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{res:Localize Projects_Export}"
                                                      Click="ExportProject_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="↓" FontSize="11" VerticalAlignment="Center"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{res:Localize Projects_Delete}"
                                                      Click="DeleteProject_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="✕" FontSize="11" VerticalAlignment="Center"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,4"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
