<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:XTMF2.GUI.ViewModels"
             xmlns:controls="clr-namespace:XTMF2.GUI.Controls"
             xmlns:res="clr-namespace:XTMF2.GUI.Resources"
             xmlns:xtmf2="clr-namespace:XTMF2;assembly=XTMF2"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="XTMF2.GUI.Views.ModelSystemsView"
             x:CompileBindings="True"
             x:DataType="vm:ModelSystemsViewModel"
             Classes="neon-view">
    
    <Grid RowDefinitions="Auto,*" Margin="10">
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TitleTextBlock"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>
            <TextBlock x:Name="UserTextBlock"
                       FontSize="14"
                       Opacity="0.7"/>
        </StackPanel>
        
        <!-- Model Systems List -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource DlgListBorder}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="0">
            
            <Grid RowDefinitions="Auto,*">
                
                <!-- Toolbar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource DlgInputBg}"
                        Padding="10,8"
                        BorderBrush="{DynamicResource DlgSep}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <Button Command="{Binding CreateNewModelSystemCommand}"
                                    Classes="dlg-primary"
                                    Padding="10,6"
                                    ToolTip.Tip="{res:Localize ModelSystems_NewModelSystem}">
                                <TextBlock Text="+" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                            </Button>
                            <Button Command="{Binding ImportModelSystemCommand}"
                                    Padding="10,6"
                                    ToolTip.Tip="{res:Localize ModelSystems_Import}">
                                <TextBlock Text="↑" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                        <controls:SearchBox Grid.Column="2"
                                            x:Name="ModelSystemSearchBox"
                                            Text="{Binding SearchText, Mode=TwoWay}"
                                            Watermark="{res:Localize ModelSystems_SearchPlaceholder}"
                                            Width="275"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0"/>
                    </Grid>
                </Border>
                
                <!-- Model Systems List -->
                <ScrollViewer Grid.Row="1">
                    <ListBox x:Name="ModelSystemListBox"
                             ItemsSource="{Binding FilteredModelSystems}"
                             SelectedItem="{Binding SelectedModelSystem, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="xtmf2:ModelSystemHeader">
                                <Border Background="{DynamicResource DlgInputBg}"
                                        BorderBrush="{DynamicResource DlgSep}"
                                        BorderThickness="0,0,0,1"
                                        Padding="15,10"
                                        Cursor="Hand"
                                        DoubleTapped="ModelSystem_DoubleTapped">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{res:Localize ModelSystems_Open}"
                                                      Click="OpenModelSystem_ContextMenu_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="→" FontSize="11" VerticalAlignment="Center"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{res:Localize ModelSystems_Rename}"
                                                      Click="RenameModelSystem_ContextMenu_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="✏" FontSize="11" VerticalAlignment="Center"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{res:Localize ModelSystems_Export}"
                                                      Click="ExportModelSystem_ContextMenu_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="↓" FontSize="11" VerticalAlignment="Center"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{res:Localize ModelSystems_Delete}"
                                                      Click="DeleteModelSystem_ContextMenu_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="✕" FontSize="11" VerticalAlignment="Center"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Border.Styles>
                                        <Style Selector="Border:pointerover">
                                            <Setter Property="Background" Value="{DynamicResource DlgHover}"/>
                                        </Style>
                                    </Border.Styles>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12"
                                                   Opacity="0.7"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
                
            </Grid>
            
        </Border>
        
    </Grid>
    
</UserControl>
