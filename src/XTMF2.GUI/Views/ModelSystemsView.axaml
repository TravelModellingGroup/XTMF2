<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:XTMF2.GUI.ViewModels"
             xmlns:views="clr-namespace:XTMF2.GUI.Views"
             xmlns:res="clr-namespace:XTMF2.GUI.Resources"
             x:Class="XTMF2.GUI.Views.ModelSystemsView"
             x:DataType="vm:ModelSystemsViewModel"
             x:CompileBindings="True">
    <Grid>
        <ContentControl Content="{Binding DisplayViewModel}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:ModelSystemsViewModel">
                    <views:ModelSystemsContentView/>
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
        <Border IsVisible="{Binding IsLoading}"
                Background="#CC000000"
                Padding="24">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="300"
                        Spacing="20">
                <TextBlock Text="{res:Localize DocumentLoad_ModelSystemsStatus}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#FFF2FCFF"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
                <ProgressBar IsIndeterminate="True"
                             Height="4"/>
                <TextBlock Text="{Binding Project.Name}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="#CCFFFFFF"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding LoadErrorMessage}"
                   IsVisible="{Binding HasLoadError}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   MaxWidth="420"
                   Margin="24"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Foreground="{DynamicResource DlgErrorFg}"/>
    </Grid>
</UserControl>
