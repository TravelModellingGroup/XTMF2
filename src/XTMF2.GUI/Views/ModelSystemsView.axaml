<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:XTMF2.GUI.ViewModels"
             xmlns:controls="clr-namespace:XTMF2.GUI.Controls"
             xmlns:res="clr-namespace:XTMF2.GUI.Resources"
             xmlns:xtmf2="clr-namespace:XTMF2;assembly=XTMF2"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="XTMF2.GUI.Views.ModelSystemsView"
             x:CompileBindings="True"
             x:DataType="vm:ModelSystemsViewModel"
             Classes="neon-view">
    
    <Grid RowDefinitions="Auto,*" Margin="10">
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TitleTextBlock"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>
            <TextBlock x:Name="UserTextBlock"
                       FontSize="14"
                       Opacity="0.7"/>
        </StackPanel>
        
        <!-- Model Systems List -->
        <Border Grid.Row="1"
            Classes="dlg-list"
            Background="Transparent"
            Padding="0">
            
            <Grid RowDefinitions="Auto,*">
                
                <!-- Toolbar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource DlgInputBg}"
                        Padding="10,8"
                        BorderBrush="{DynamicResource DlgSep}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <StackPanel.Styles>
                                <Style Selector="Button.toolbar-icon">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="CornerRadius" Value="20"/>
                                    <Setter Property="Padding" Value="7,5"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="Width" Value="34"/>
                                    <Setter Property="Height" Value="30"/>
                                </Style>
                                <Style Selector="Button.toolbar-icon:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource DlgHover}"/>
                                </Style>
                                <Style Selector="Button.toolbar-icon:pressed /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource DlgAccentMid}"/>
                                </Style>
                            </StackPanel.Styles>
                            <Button Command="{Binding CreateNewModelSystemCommand}"
                                    Classes="toolbar-icon"
                                    ToolTip.Tip="{res:Localize ModelSystems_NewModelSystem}">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M 10,4 V 16 M 4,10 H 16"
                                              Stroke="{DynamicResource NeonIconPrimary}"
                                              StrokeThickness="2.2"
                                              StrokeLineCap="Round"
                                              Fill="Transparent"/>
                                        <Ellipse Width="2.8"
                                                 Height="2.8"
                                                 Canvas.Left="8.6"
                                                 Canvas.Top="8.6"
                                                 Fill="{DynamicResource NeonIconSecondary}"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button Command="{Binding ImportModelSystemCommand}"
                                    Classes="toolbar-icon"
                                    ToolTip.Tip="{res:Localize ModelSystems_Import}">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M 10,4 V 12 M 6.5,8.5 L 10,12 L 13.5,8.5"
                                              Stroke="{DynamicResource NeonIconPrimary}"
                                              StrokeThickness="1.9"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round"
                                              Fill="Transparent"/>
                                        <Path Data="M 4,13.5 V 16 H 16 V 13.5"
                                              Stroke="{DynamicResource NeonIconSecondary}"
                                              StrokeThickness="1.8"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round"
                                              Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button Command="{Binding OpenProjectDirectoryCommand}"
                                    Classes="toolbar-icon"
                                    ToolTip.Tip="{res:Localize ModelSystems_OpenProjectDirectory}">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M 2.5,7 H 8 L 9.8,5 H 17.5 V 16.5 H 2.5 Z"
                                              Stroke="{DynamicResource NeonIconPrimary}"
                                              StrokeThickness="1.7"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round"
                                              Fill="Transparent"/>
                                        <Path Data="M 2.5,9.2 H 17.5"
                                              Stroke="{DynamicResource NeonIconSecondary}"
                                              StrokeThickness="1.5"
                                              StrokeLineCap="Round"
                                              Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                        <controls:SearchBox Grid.Column="2"
                                            x:Name="ModelSystemSearchBox"
                                            Text="{Binding SearchText, Mode=TwoWay}"
                                            Watermark="{res:Localize ModelSystems_SearchPlaceholder}"
                                            Width="275"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0"/>
                    </Grid>
                </Border>
                
                <!-- Model Systems List -->
                <ScrollViewer Grid.Row="1" Background="Transparent">
                    <ListBox x:Name="ModelSystemListBox"
                             ItemsSource="{Binding FilteredModelSystems}"
                             SelectedItem="{Binding SelectedModelSystem, Mode=TwoWay}"
                             Background="Transparent">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="3"/>
                                <Setter Property="CornerRadius" Value="6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                            <Style Selector="ListBoxItem /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource DlgHover}"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource DlgSelected}"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource DlgSelected}"/>
                            </Style>
                            <Style Selector="ListBoxItem > Border.modelsystem-row">
                                <Setter Property="CornerRadius" Value="6"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource DlgSep}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding" Value="15,10"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover > Border.modelsystem-row">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected > Border.modelsystem-row">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected:pointerover > Border.modelsystem-row">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="xtmf2:ModelSystemHeader">
                                <Border Classes="modelsystem-row" Background="Transparent"
                                    BorderBrush="{DynamicResource DlgSep}"
                                        BorderThickness="0,0,0,1"
                                        Padding="15,10"
                                        Cursor="Hand"
                                        DoubleTapped="ModelSystem_DoubleTapped">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{res:Localize ModelSystems_Open}"
                                                      Click="OpenModelSystem_ContextMenu_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="→" FontSize="11" VerticalAlignment="Center"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{res:Localize ModelSystems_Rename}"
                                                      Click="RenameModelSystem_ContextMenu_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="✏" FontSize="11" VerticalAlignment="Center"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{res:Localize ModelSystems_Export}"
                                                      Click="ExportModelSystem_ContextMenu_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="↓" FontSize="11" VerticalAlignment="Center"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{res:Localize ModelSystems_Compare}"
                                                      Click="CompareModelSystem_ContextMenu_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="⟷" FontSize="11" VerticalAlignment="Center"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{res:Localize ModelSystems_Delete}"
                                                      Click="DeleteModelSystem_ContextMenu_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="✕" FontSize="11" VerticalAlignment="Center"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12"
                                                   Opacity="0.7"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
                
            </Grid>
            
        </Border>
        
    </Grid>
    
</UserControl>
