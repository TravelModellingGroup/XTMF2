<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:XTMF2.GUI.ViewModels"
        xmlns:local="clr-namespace:XTMF2.GUI.Views"
    xmlns:controls="clr-namespace:XTMF2.GUI.Controls"
        xmlns:xtmf2="clr-namespace:XTMF2.ModelSystemConstruct;assembly=XTMF2"
        x:Class="XTMF2.GUI.Views.CalibrationDialog"
        x:DataType="local:CalibrationDialog"
        x:CompileBindings="True"
        Classes="neon-dialog"
        Title="Calibration Parameters"
        Width="1100"
        Height="600"
        MinWidth="540"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBox.invalid-number">
            <Setter Property="Background" Value="#33FF3030"/>
            <Setter Property="BorderBrush" Value="#CC4444"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Calibration Parameters"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource DlgAccent}"/>
            <TextBlock Text="Organise parameters into named groups. Each entry specifies a Model Output node (what the model produces) and a Target Output node (observed/expected value). The calibration ratio is Target / Model."
                       FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ── Body: groups (left) + group details (right) ────────────────── -->
        <Grid Grid.Row="1" ColumnDefinitions="210,8,*" RowDefinitions="Auto,*">

            <Grid Grid.Row="0" Grid.ColumnSpan="3" ColumnDefinitions="Auto,220,*" Margin="0,0,0,10">
                <TextBlock Grid.Column="0"
                           Text="Default Algorithm" FontSize="11" FontWeight="SemiBold"
                           Opacity="0.5" LetterSpacing="0.8"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{x:Static local:CalibrationDialog.AvailableAlgorithms}"
                          SelectedItem="{Binding GroupDefaultAlgorithm, Mode=TwoWay}"
                          ToolTip.Tip="Algorithm assigned to new entries added to this group"
                          FontSize="12" Width="200" HorizontalAlignment="Left"/>
            </Grid>

            <!-- ── Left: group list ───────────────────────────────────────── -->
            <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Row="0"
                           Text="Groups" FontSize="11" FontWeight="SemiBold"
                           Opacity="0.5" LetterSpacing="0.8" Margin="0,0,0,4"/>
                <controls:SearchBox Grid.Row="1"
                                    Text="{Binding GroupSearchText, Mode=TwoWay}"
                                    Watermark="Search groups..."
                                    Margin="0,0,0,6"/>
                <Border Grid.Row="2" Classes="dlg-list" ClipToBounds="True">
                    <ListBox x:Name="GroupListBox"
                             ItemsSource="{Binding FilteredGroupVms}"
                             SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                             Background="Transparent"
                             KeyDown="GroupList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CalibrationGroupViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,3">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Rename"
                                                      Tag="{Binding}"
                                                      Click="RenameGroup_Click"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsEnabled}"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="Enable this group"
                                              IsCheckedChanged="GroupEnabled_Changed"
                                              Margin="0,0,6,0"/>
                                    <Panel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   IsVisible="{Binding !IsEditing}"
                                                   FontWeight="SemiBold" FontSize="12"/>
                                        <TextBox Text="{Binding EditName, Mode=TwoWay}"
                                                 IsVisible="{Binding IsEditing}"
                                                 KeyDown="GroupRenameBox_KeyDown"
                                                 LostFocus="GroupRenameBox_LostFocus"
                                                 FontSize="12" Padding="2,1"
                                                 VerticalAlignment="Center"/>
                                    </Panel>
                                    <Button Grid.Column="2" Classes="dlg-danger"
                                            ToolTip.Tip="Remove group"
                                            Click="RemoveGroup_Click" Tag="{Binding}"
                                            Padding="4,2" Margin="4,0,0,0">
                                        <TextBlock Text="✕" FontSize="10"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <Button Grid.Row="3" Content="+ Add Group" Click="AddGroup_Click" Padding="10,5" HorizontalAlignment="Stretch"/>
            </Grid>

            <!-- ── Right: group details ───────────────────────────────────── -->
            <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*" IsEnabled="{Binding HasSelectedGroup}">

                <TextBlock Grid.Row="0"
                           Text="Targets" FontSize="11" FontWeight="SemiBold"
                           Opacity="0.5" LetterSpacing="0.8" Margin="0,0,0,4"/>

                <controls:SearchBox Grid.Row="1"
                                    Text="{Binding TargetSearchText, Mode=TwoWay}"
                                    Watermark="Search targets..."
                                    Margin="0,0,0,8"/>

                <ScrollViewer Grid.Row="2"
                              Grid.RowSpan="2"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <Grid RowDefinitions="Auto,*" MinWidth="940" Margin="0,0,6,0">
                        <!-- Parameters column headers -->
                        <Grid Grid.Row="0" ColumnDefinitions="24,*,200,110,110,80,80,70,80,36"
                              Margin="6,0,6,2">
                            <TextBlock Grid.Column="1" Text="Parameter"      FontSize="10" FontWeight="SemiBold" Opacity="0.5" LetterSpacing="0.8"/>
                            <TextBlock Grid.Column="2" Text="Algorithm"      FontSize="10" FontWeight="SemiBold" Opacity="0.5" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Model Output"   FontSize="10" FontWeight="SemiBold" Opacity="0.5" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="Target Output"  FontSize="10" FontWeight="SemiBold" Opacity="0.5" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="Min"            FontSize="10" FontWeight="SemiBold" Opacity="0.5" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="Max"            FontSize="10" FontWeight="SemiBold" Opacity="0.5" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="Tolerance"      FontSize="10" FontWeight="SemiBold" Opacity="0.5" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="8" Text="Step Size"      FontSize="10" FontWeight="SemiBold" Opacity="0.5" HorizontalAlignment="Center"/>
                        </Grid>

                        <!-- Parameters list -->
                        <Border Grid.Row="1" Classes="dlg-list" ClipToBounds="True">
                            <ListBox ItemsSource="{Binding FilteredGroupEntries}"
                                     SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                     Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CalibrationEntryViewModel">
                                        <Grid ColumnDefinitions="24,*,200,110,110,80,80,70,80,36" Margin="2,3">
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      ToolTip.Tip="Include in calibration run"
                                                      IsCheckedChanged="EntryEnabled_Changed"
                                                      />
                                            <TextBlock Grid.Column="1" Text="{Binding NodeName}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Go To Node"
                                                                  Tag="{Binding Entry.Node}"
                                                                  Click="GoToNode_Click"/>
                                                    </ContextMenu>
                                                </TextBlock.ContextMenu>
                                            </TextBlock>
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{x:Static local:CalibrationDialog.AvailableAlgorithms}"
                                                      SelectedItem="{Binding Algorithm, Mode=TwoWay}"
                                                      FontSize="11" Padding="4,2" Width="200"
                                                      SelectionChanged="EntryAlgorithm_SelectionChanged"/>
                                            <TextBlock Grid.Column="3" Text="{Binding ModelOutputNodeName}"
                                                       VerticalAlignment="Center" FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Opacity="0.7">
                                                <TextBlock.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Go To Node"
                                                                  Tag="{Binding Entry.ModelOutputNode}"
                                                                  Click="GoToNode_Click"/>
                                                    </ContextMenu>
                                                </TextBlock.ContextMenu>
                                            </TextBlock>
                                            <TextBlock Grid.Column="4" Text="{Binding TargetOutputNodeName}"
                                                       VerticalAlignment="Center" FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Opacity="0.7">
                                                <TextBlock.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Go To Node"
                                                                  Tag="{Binding Entry.TargetOutputNode}"
                                                                  Click="GoToNode_Click"/>
                                                    </ContextMenu>
                                                </TextBlock.ContextMenu>
                                            </TextBlock>
                                            <TextBox Grid.Column="5" Text="{Binding EditMin, Mode=TwoWay}"
                                                     FontSize="11" LostFocus="EntryTextBox_LostFocus"
                                                     KeyDown="EntryTextBox_KeyDown"
                                                     TextChanged="EntryNumericBox_TextChanged"
                                                     HorizontalContentAlignment="Center" Padding="2,2"/>
                                            <TextBox Grid.Column="6" Text="{Binding EditMax, Mode=TwoWay}"
                                                     FontSize="11" LostFocus="EntryTextBox_LostFocus"
                                                     KeyDown="EntryTextBox_KeyDown"
                                                     TextChanged="EntryNumericBox_TextChanged"
                                                     HorizontalContentAlignment="Center" Padding="2,2"/>
                                            <TextBox Grid.Column="7" Text="{Binding EditErrorTolerance, Mode=TwoWay}"
                                                     FontSize="11" LostFocus="EntryTextBox_LostFocus"
                                                     KeyDown="EntryTextBox_KeyDown"
                                                     TextChanged="EntryNumericBox_TextChanged"
                                                     ToolTip.Tip="Convergence tolerance: skip updating if |ratio-1| ≤ this value"
                                                     HorizontalContentAlignment="Center" Padding="2,2"/>
                                            <TextBox Grid.Column="8" Text="{Binding EditStepSize, Mode=TwoWay}"
                                                     FontSize="11" LostFocus="EntryTextBox_LostFocus"
                                                     KeyDown="EntryTextBox_KeyDown"
                                                     TextChanged="EntryNumericBox_TextChanged"
                                                     ToolTip.Tip="Fraction of the calibration correction applied each iteration"
                                                     HorizontalContentAlignment="Center" Padding="2,2"/>
                                            <Button Grid.Column="9" Classes="dlg-danger"
                                                    ToolTip.Tip="Remove from calibration"
                                                    Click="RemoveEntry_Click" Tag="{Binding}">
                                                <TextBlock Text="✕" FontSize="11"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </ScrollViewer>

            </Grid>
        </Grid>

        <!-- ── Output nodes for selected entry ───────────────────────────────── -->
        <Border Grid.Row="2"
                IsVisible="{Binding HasSelectedEntry}"
                BorderBrush="{DynamicResource DlgSep}"
                BorderThickness="0,1,0,0"
                Padding="4,8,4,4"
                Margin="0,8,0,0">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding SelectedEntryHeader}"
                           FontSize="11" Opacity="0.6" Margin="0,0,0,2"/>
                <!-- Model Output node row -->
                <Grid ColumnDefinitions="120,*,Auto">
                    <TextBlock Grid.Column="0" Text="Model Output:" VerticalAlignment="Center"
                               FontSize="12" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding FunctionNodes}"
                              SelectedItem="{Binding SelectedModelOutputNode, Mode=TwoWay}"
                              PlaceholderText="(none)"
                              FontSize="12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="xtmf2:Node">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2" Content="Clear"
                            Click="ClearModelOutputNode_Click" Margin="4,0,0,0" Padding="10,5"/>
                </Grid>
                <!-- Target Output node row -->
                <Grid ColumnDefinitions="120,*,Auto">
                    <TextBlock Grid.Column="0" Text="Target Output:" VerticalAlignment="Center"
                               FontSize="12" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding FunctionNodes}"
                              SelectedItem="{Binding SelectedTargetOutputNode, Mode=TwoWay}"
                              PlaceholderText="(none)"
                              FontSize="12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="xtmf2:Node">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2" Content="Clear"
                            Click="ClearTargetOutputNode_Click" Margin="4,0,0,0" Padding="10,5"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── Footer ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource DlgSep}" BorderThickness="0,1,0,0"
                Margin="0,8,0,0" Padding="0,8,0,0">
            <Button Content="Close" HorizontalAlignment="Right"
                    Padding="24,8" IsCancel="True" Click="Close_Click"/>
        </Border>

    </Grid>
</Window>
