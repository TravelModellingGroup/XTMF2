<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XTMF2.GUI.Views"
        xmlns:res="clr-namespace:XTMF2.GUI.Resources"
        x:Class="XTMF2.GUI.Views.CodeStyleErrorDialog"
        x:CompileBindings="True"
        x:DataType="local:CodeStyleErrorDialog"
        Classes="neon-dialog"
        Width="640"
        Height="420"
        MinWidth="520"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20">

        <!-- Intro + icon -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
            <Viewbox Grid.Column="0"
                     Width="32"
                     Height="32"
                     Margin="0,0,12,0"
                     VerticalAlignment="Top">
                <Panel Width="24" Height="24">
                    <Ellipse Width="24" Height="24" Fill="#D32F2F"/>
                    <Path Data="M 7,7 L 17,17 M 17,7 L 7,17"
                          Stroke="White"
                          StrokeThickness="2"
                          StrokeLineCap="Round"/>
                </Panel>
            </Viewbox>
            <TextBlock Grid.Column="1"
                       Text="{Binding IntroText}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Error tabs (left) + selected error detail (right) -->
        <Grid Grid.Row="1" ColumnDefinitions="180,*" Margin="0,15,0,0">

            <Border Grid.Column="0"
                    Classes="dlg-list"
                    Margin="0,0,10,0">
                <ListBox x:Name="ErrorListBox"
                         ItemsSource="{Binding Errors}"
                         SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                         SelectionChanged="ErrorListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:CodeStyleErrorEntry">
                            <TextBlock Text="{Binding Label}"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1"
                    Classes="dlg-list"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding CurrentMessage}"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

        </Grid>

        <Separator Grid.Row="2" Margin="0,15,0,0"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,15,0,0">
            <Button Content="{res:Localize Dialog_OK}"
                    Classes="dlg-primary"
                    Click="OK_Click"
                    IsDefault="True"/>
        </StackPanel>

    </Grid>

</Window>
