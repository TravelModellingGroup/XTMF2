<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:XTMF2.GUI.Resources"
        mc:Ignorable="d"
        x:Class="XTMF2.GUI.Views.RunServersWindow"
        Classes="neon-dialog"
        Title="RunServers"
        KeyDown="Window_KeyDown"
        Width="820"
        Height="560"
        MinWidth="680"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Focusable="True"
        >

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="RunServers" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DlgAccent}"/>
            <TextBlock Text="Configure and monitor the RunServer endpoints used for model-system runs."
                       FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
            <TextBlock Text="Select an endpoint to edit its connection details."
                       FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="210,8,*">
            <Grid Grid.Column="0" RowDefinitions="*,Auto">
                <Border Grid.Row="0" Classes="dlg-list" ClipToBounds="True">
                    <ListBox x:Name="EndpointSelector"
                             Background="Transparent"
                             SelectionChanged="EndpointSelector_SelectionChanged"/>
                </Border>
                <Button Grid.Row="1" Content="+ Add RunServer" Click="AddRunServer_Click"
                        HorizontalAlignment="Stretch" Padding="10,5"/>
            </Grid>

            <Border Grid.Column="2" Classes="dlg-list" Padding="16" ClipToBounds="True">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="EndpointDetailsPanel" Spacing="12"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource DlgSep}" BorderThickness="0,1,0,0"
                Margin="0,8,0,0" Padding="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Grid.Column="2" Content="Save" Click="Save_Click" Width="100" Height="34" Classes="dlg-primary"/>
            <Button Grid.Column="3" Content="Cancel" Click="Cancel_Click" Width="100" Height="34"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
