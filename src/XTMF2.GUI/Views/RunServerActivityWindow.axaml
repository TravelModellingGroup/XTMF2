<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="XTMF2.GUI.Views.RunServerActivityWindow"
        Classes="neon-dialog"
        Title="RunServer Activity"
        Width="1040"
        Height="680"
        MinWidth="760"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">
    <Grid RowDefinitions="Auto,*,Auto" Margin="18">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Spacing="3">
                <TextBlock Text="RunServer activity" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource DlgAccent}"/>
                <TextBlock x:Name="UpdatedText" Text="Waiting for server state" FontSize="11" Opacity="0.65"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="RefreshButton" Content="Refresh"
                    Click="Refresh_Click" MinWidth="96" Height="34"/>
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ServerList" Spacing="14"/>
        </ScrollViewer>
        <TextBlock Grid.Row="2" x:Name="StatusText" Margin="0,10,0,0"
                   FontSize="11" Opacity="0.72" TextWrapping="Wrap"/>
    </Grid>
</Window>