<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:XTMF2.GUI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
             x:Class="XTMF2.GUI.Views.RunsView"
             x:DataType="vm:RunsViewModel"
             x:CompileBindings="True">

    <Grid RowDefinitions="Auto,*" Margin="10">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Runs"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,2"/>
            <TextBlock Text="Active and completed model system runs"
                       FontSize="13"
                       Opacity="0.6"/>
        </StackPanel>

        <!-- Two-column layout: run list | detail panel -->
        <Grid Grid.Row="1" ColumnDefinitions="260,Auto,*">

            <!-- Left: run list -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid RowDefinitions="Auto,*">

                    <!-- Clear Completed button above the list -->
                    <Button Grid.Row="0"
                            Content="Clear Completed"
                            Command="{Binding ClearCompletedRunsCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="4,4,4,2"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Runs}"
                             SelectedItem="{Binding SelectedRun, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RunViewModel" x:CompileBindings="False">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,6">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding StatusBadge}"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RunName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="11"
                                                   Opacity="0.65"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="🗑"
                                            FontSize="14"
                                            Padding="4,2"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding IsCompleted}"
                                            Command="{Binding DataContext.RemoveRunCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Width="5"
                          Background="Transparent"
                          Margin="2,0"/>

            <!-- Right: message log for the selected run -->
            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8">
                <Grid RowDefinitions="Auto,*">

                    <!-- Run name / status header -->
                    <StackPanel Grid.Row="0"
                                IsVisible="{Binding SelectedRun, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Margin="0,0,0,8">
                        <TextBlock Text="{Binding SelectedRun.RunName}"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding SelectedRun.StatusBadge}" FontSize="14"/>
                            <TextBlock Text="{Binding SelectedRun.StatusText}"
                                       FontSize="12"
                                       Opacity="0.7"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Message log -->
                    <ScrollViewer Grid.Row="1"
                                  x:Name="MessageScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding SelectedRun, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <ItemsControl ItemsSource="{Binding SelectedRun.Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Padding="2,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Placeholder when no run selected -->
                    <TextBlock Grid.Row="1"
                               Text="Select a run to view its log."
                               Opacity="0.5"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding SelectedRun, Converter={x:Static ObjectConverters.IsNull}}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
