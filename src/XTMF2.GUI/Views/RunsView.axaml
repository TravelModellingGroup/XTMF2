<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:XTMF2.GUI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
             x:Class="XTMF2.GUI.Views.RunsView"
             x:DataType="vm:RunsViewModel"
             x:CompileBindings="True"
             Classes="neon-view">

    <UserControl.Styles>
        <Style Selector="Button.run-header-icon">
            <Setter Property="Foreground" Value="{DynamicResource NeonIconSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NeonIconPrimary}"/>
        </Style>
        <Style Selector="Button.run-header-icon:disabled">
            <Setter Property="Foreground" Value="#FF808080"/>
            <Setter Property="BorderBrush" Value="#FF808080"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="10">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Runs"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,2"/>
            <TextBlock Text="Active and completed model system runs"
                       FontSize="13"
                       Opacity="0.6"/>
        </StackPanel>

        <!-- Two-column layout: run list | detail panel -->
        <Grid Grid.Row="1" ColumnDefinitions="260,Auto,*">

            <!-- Left: run list -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource DlgListBorder}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid RowDefinitions="*,Auto">

                    <ListBox Grid.Row="0"
                             ItemsSource="{Binding Runs}"
                             SelectedItem="{Binding SelectedRun, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RunViewModel" x:CompileBindings="False">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,6">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding StatusBadge}"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RunName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding RunServer}"
                                                   FontSize="10"
                                                   Opacity="0.55"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="11"
                                                   Opacity="0.65"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal"
                                                Spacing="4"
                                                IsVisible="{Binding IsOptimizationRun}">
                                            <TextBlock Text="Iteration" FontSize="10" Opacity="0.5"/>
                                            <TextBlock Text="{Binding CurrentIteration}"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                            <TextBlock Text="Tests" FontSize="10" Opacity="0.5" Margin="4,0,0,0"/>
                                            <TextBlock Text="{Binding CurrentIterationFitnessTests}"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="🗑"
                                            Classes="dlg-danger"
                                            FontSize="14"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding IsCompleted}"
                                            Click="RemoveRunButton_Click"
                                            ToolTip.Tip="Remove this run; remote runs are deleted from their RunServer."/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="1"
                            Content="Clear Completed"
                            Click="ClearCompletedRunsButton_Click"
                            Classes="dlg-primary"
                            HorizontalAlignment="Stretch"
                            Margin="0,4,0,2"
                            ToolTip.Tip="Clears completed local runs and remote runs whose output has transferred to this computer. Remote-only runs are kept."/>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Width="5"
                          Background="Transparent"
                          Margin="2,0"/>

            <!-- Right: message log for the selected run -->
            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource DlgListBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8">
                <Grid RowDefinitions="Auto,*">

                    <!-- Run name / status header -->
                    <StackPanel Grid.Row="0"
                                IsVisible="{Binding SelectedRun, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Text="{Binding SelectedRun.RunName}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="OpenRunDirectoryButton"
                                    Grid.Column="1"
                                    Classes="run-header-icon"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    MinWidth="32"
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Command="{Binding SelectedRun.OpenRunDirectoryCommand}"
                                    IsEnabled="{Binding SelectedRun.CanOpenRunDirectory}"
                                    Margin="0,0,4,0"
                                    ToolTip.Tip="Open this run's output directory."
                                    AutomationProperties.Name="Open run output directory">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="20" Height="20">
                                        <Path x:Name="OpenRunDirectoryPrimaryIcon"
                                              Data="M 2,6 H 8 L 10,8 H 18 V 17 H 2 Z"
                                              Stroke="{Binding #OpenRunDirectoryButton.BorderBrush}"
                                              StrokeThickness="1.8"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round"
                                              Fill="Transparent"/>
                                        <Path x:Name="OpenRunDirectorySecondaryIcon"
                                              Data="M 2,6 H 8 L 10,8 H 2 Z"
                                              Fill="{Binding #OpenRunDirectoryButton.Foreground}"
                                              StrokeThickness="0"/>
                                        <Path
                                              Data="M 2,9 H 18"
                                              Stroke="{Binding #OpenRunDirectoryButton.Foreground}"
                                              StrokeThickness="1.2"
                                              StrokeLineCap="Round"
                                              Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button x:Name="CancelRunButton"
                                    Grid.Column="2"
                                    Classes="run-header-icon"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    MinWidth="32"
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    IsEnabled="{Binding SelectedRun.CanRequestCancelRun}"
                                    Click="CancelRunButton_Click"
                                    ToolTip.Tip="Cancel this run.">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="20" Height="20">
                                        <Path x:Name="CancelRunIcon"
                                              Data="M 5,5 L 15,15 M 15,5 L 5,15"
                                              Stroke="{Binding #CancelRunButton.Foreground}"
                                              StrokeThickness="2.4"
                                              StrokeLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding SelectedRun.RunServer}"
                                   FontSize="11"
                                   Opacity="0.6"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding SelectedRun.StatusBadge}" FontSize="14"/>
                            <TextBlock Text="{Binding SelectedRun.StatusText}"
                                       FontSize="12"
                                       Opacity="0.7"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Cancellation requested…"
                                   IsVisible="{Binding SelectedRun.IsCancellationRequested}"
                                   FontSize="11"
                                   Opacity="0.7"
                                   Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    Margin="0,4,0,0"
                                    IsVisible="{Binding SelectedRun.IsOptimizationRun}">
                            <TextBlock Text="Iteration" FontSize="11" Opacity="0.55"/>
                            <TextBlock Text="{Binding SelectedRun.CurrentIteration}"
                                       FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="Fitness tests" FontSize="11" Opacity="0.55"/>
                            <TextBlock Text="{Binding SelectedRun.CurrentIterationFitnessTests}"
                                       FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="Best fitness" FontSize="11" Opacity="0.55"/>
                            <TextBlock Text="{Binding SelectedRun.CurrentFitness, StringFormat=G6}"
                                       FontSize="11" FontWeight="SemiBold"
                                       FontFamily="Cascadia Code,Consolas,monospace"/>
                        </StackPanel>
                            <TextBlock Text="{Binding SelectedRun.OutputTransferStatus}"
                                   IsVisible="{Binding SelectedRun.IsRemoteRun}"
                                   FontSize="11" Opacity="0.7" Margin="0,4,0,0"/>
                            <ProgressBar Minimum="0" Maximum="100"
                                      Value="{Binding SelectedRun.ArtifactTransferProgress}"
                                      IsVisible="{Binding SelectedRun.ShowArtifactTransferProgress}"
                                      Height="8" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding SelectedRun.ArtifactTransferProgressText}"
                                    IsVisible="{Binding SelectedRun.ShowArtifactTransferProgress}"
                                    FontSize="10" Opacity="0.65"/>
                            <Button Content="Transfer Output to This Computer"
                                IsVisible="{Binding SelectedRun.CanTransferRemoteOutput}"
                                Classes="dlg-primary"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Left"
                                Click="TransferRemoteOutputButton_Click"/>
                            <Button Content="Bind to Active Model System"
                                IsVisible="{Binding SelectedRun.IsRecoveredRunUnbound}"
                                Classes="dlg-primary"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Left"
                                Click="BindRecoveredRunButton_Click"/>
                            <Button Content="Retry Remote Output Receipt"
                                IsVisible="{Binding SelectedRun.HasPendingRemoteReceipt}"
                                Classes="dlg-primary"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Left"
                                Click="RetryRemoteReceiptButton_Click"/>
                        <Button Content="{Binding SelectedRun.ErrorNavigationLinkText}"
                            IsVisible="{Binding SelectedRun.HasErrorNavigationTarget}"
                            Classes="dlg-primary"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Left"
                            Click="OpenErrorTargetButton_Click"
                            ToolTip.Tip="Open this run's model system and focus the element that raised the error."/>
                        <!-- Apply optimization results button — only visible after estimation/calibration runs -->
                        <Button Content="⬇  Apply Optimization Results to Model System"
                                Command="{Binding SelectedRun.ApplyOptimizationResultsCommand}"
                                IsVisible="{Binding SelectedRun.HasOptimizationResults}"
                                Classes="dlg-primary"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Left"
                                ToolTip.Tip="Write the estimated/calibrated parameter values back into the model system. Undoable."/>
                        <!-- View per-iteration progress — only visible for estimation/calibration runs -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button x:Name="ViewProgressButton"
                                Content="📊  View Parameter Progress"
                                IsVisible="{Binding SelectedRun.IsOptimizationRun}"
                                Classes="dlg-primary"
                                HorizontalAlignment="Left"
                                Click="ViewProgressButton_Click"
                                ToolTip.Tip="Open the live optimisation progress window for this run."/>
                            <Button x:Name="EstimationWorkersButton"
                                Content="Estimation Workers"
                                IsVisible="{Binding SelectedRun.IsRemoteSharedEstimation}"
                                Classes="dlg-primary"
                                HorizontalAlignment="Left"
                                Click="EstimationWorkersButton_Click"
                                ToolTip.Tip="Add or remove RunServers participating in this estimation."/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Message log -->
                    <ScrollViewer Grid.Row="1"
                                  x:Name="MessageScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding SelectedRun, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <SelectableTextBlock x:Name="MessageTextBlock"
                                             Text="{Binding SelectedRun.MessageLog}"
                                             FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                             FontSize="12"
                                             TextWrapping="Wrap"
                                             Margin="2,1"/>
                    </ScrollViewer>

                    <!-- Placeholder when no run selected -->
                    <TextBlock Grid.Row="1"
                               Text="Select a run to view its log."
                               Opacity="0.5"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding SelectedRun, Converter={x:Static ObjectConverters.IsNull}}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
