<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:XTMF2.GUI.Resources"
        xmlns:local="clr-namespace:XTMF2.GUI.Views"
        x:Class="XTMF2.GUI.Views.ParameterEditorDialog"
        x:CompileBindings="True"
        x:DataType="local:ParameterEditorDialog"
        Classes="neon-dialog"
        Title="Edit Parameter"
        Width="460"
        Height="240"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="20">

        <!-- Row 0: inner type label -->
        <TextBlock Grid.Row="0"
                   Text="{Binding TypeLabel}"
                   FontSize="13"
                   Foreground="{DynamicResource DlgSubFg}"
                   Margin="0,0,0,10"/>

        <!-- Row 1: mode radio buttons -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="20"
                    Margin="0,0,0,8">
            <RadioButton Content="Value  (Basic Parameter)"
                         IsChecked="{Binding IsBasicMode}"
                         GroupName="ParameterMode"/>
            <RadioButton Content="Expression  (Scripted Parameter)"
                         IsChecked="{Binding IsScriptedMode}"
                         GroupName="ParameterMode"/>
        </StackPanel>

        <!-- Row 2: value / expression text box -->
        <TextBox Grid.Row="2"
                 x:Name="ValueTextBox"
                 Text="{Binding ValueText}"
                 Watermark="Enter value…"
                 AcceptsReturn="False"
                 Margin="0,0,0,4"/>

        <!-- Row 3: inline error message -->
        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource DlgErrorFg}"
                   FontSize="12"
                   IsVisible="{Binding HasError}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4"/>

        <!-- Row 5: OK / Cancel -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,8,0,0">
            <Button Content="{res:Localize Dialog_OK}"
                    Classes="dlg-primary"
                    Click="OK_Click"
                    IsDefault="True"
                    Padding="20,8"
                    MinWidth="80"/>
            <Button Content="{res:Localize Dialog_Cancel}"
                    Click="Cancel_Click"
                    IsCancel="True"
                    Padding="20,8"
                    MinWidth="80"/>
        </StackPanel>

    </Grid>

</Window>
