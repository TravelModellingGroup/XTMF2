<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:XTMF2.GUI.Resources"
        xmlns:system="using:System"
        xmlns:ctrl="clr-namespace:XTMF2.GUI.Controls"
        xmlns:local="using:XTMF2.GUI.Views"
        x:Class="XTMF2.GUI.Views.TypePickerDialog"
        x:CompileBindings="True"
        x:DataType="local:TypePickerDialog"
        Classes="neon-dialog"
        Title="Select Module Type"
        Width="540"
        Height="440"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

        <!-- Prompt -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Prompt}"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <!-- Search box -->
        <ctrl:SearchBox Grid.Row="1"
                        x:Name="FilterBox"
                        Text="{Binding FilterText, Mode=TwoWay}"
                        Watermark="Filter by type name…"
                        Margin="0,0,0,6"/>

        <!-- Filtered list of types (or empty-state message) -->
        <Border Grid.Row="2"
                Classes="dlg-list">
            <Grid>
                <!-- The type list, hidden when nothing matches -->
                <ListBox x:Name="TypeListBox"
                         ItemsSource="{Binding FilteredTypes}"
                         SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         IsVisible="{Binding !HasNoResults}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="system:Type" x:CompileBindings="False">
                            <StackPanel Spacing="1" Margin="4,2">
                                <TextBlock Text="{Binding Converter={x:Static ctrl:FriendlyTypeNameConverter.Instance}}"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>
                                <TextBlock Text="{Binding Namespace}"
                                           FontSize="11"
                                           Opacity="0.6"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty-state overlay shown when the filter has no matches -->
                <TextBlock Text="No types match the current filter."
                           IsVisible="{Binding HasNoResults}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Opacity="0.5"
                           FontStyle="Italic"/>
            </Grid>
        </Border>

        <!-- OK / Cancel -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,12,0,0">
            <Button Content="{res:Localize Dialog_OK}"
                    Classes="dlg-primary"
                    Click="OK_Click"
                    IsDefault="True"
                    IsEnabled="{Binding !HasNoResults}"
                    Padding="24,8"
                    MinWidth="80"/>
            <Button Content="{res:Localize Dialog_Cancel}"
                    Click="Cancel_Click"
                    IsCancel="True"
                    Padding="24,8"
                    MinWidth="80"/>
        </StackPanel>

    </Grid>
</Window>
