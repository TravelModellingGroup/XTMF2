<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:XTMF2.GUI.Resources"
        xmlns:xtmf2="clr-namespace:XTMF2;assembly=XTMF2"
        x:Class="XTMF2.GUI.Views.HookPickerDialog"
        x:CompileBindings="False"
        xmlns:vm="clr-namespace:XTMF2.GUI.ViewModels"
        Title="Select Hook"
        Width="460"
        Height="340"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- Prompt -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Prompt}"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <!-- Hook list -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="1"
                CornerRadius="3">
            <ListBox x:Name="HookListBox"
                     ItemsSource="{Binding Hooks}"
                     SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="xtmf2:NodeHook">
                        <StackPanel Spacing="2" Margin="4,3">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Type.Name}"
                                           FontSize="11"
                                           Opacity="0.6"/>
                                <TextBlock Text="{Binding Cardinality}"
                                           FontSize="11"
                                           Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- OK / Cancel -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,12,0,0">
            <Button Content="{res:Localize Dialog_OK}"
                    Click="OK_Click"
                    IsDefault="True"
                    Padding="24,8"
                    MinWidth="80"/>
            <Button Content="{res:Localize Dialog_Cancel}"
                    Click="Cancel_Click"
                    IsCancel="True"
                    Padding="24,8"
                    MinWidth="80"/>
        </StackPanel>

    </Grid>
</Window>
