<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:XTMF2.GUI.Resources"
        xmlns:ctrl="clr-namespace:XTMF2.GUI.Controls"
        xmlns:local="using:XTMF2.GUI.Views"
        x:Class="XTMF2.GUI.Views.FunctionParameterPickerDialog"
        x:CompileBindings="True"
        x:DataType="local:FunctionParameterPickerDialog"
        Classes="neon-dialog"
        Title="Add Function Parameter"
        Width="460"
        SizeToContent="Height"
        MaxHeight="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="20">

            <!-- ── Name ──────────────────────────────────────────── -->
            <TextBlock Grid.Row="0"
                       Text="Parameter name:"
                       FontSize="13"
                       Margin="0,0,0,4"/>

            <TextBox Grid.Row="1"
                     x:Name="NameBox"
                     Text="{Binding ParameterName, Mode=TwoWay}"
                     Watermark="Enter parameter name…"
                     Margin="0,0,0,16"/>

            <!-- ── Basic type choices ─────────────────────────────── -->
            <TextBlock Grid.Row="2"
                       Text="Parameter type — basic:"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <StackPanel Grid.Row="3"
                        Spacing="6"
                        Margin="0,0,0,14">

                <RadioButton GroupName="fpType"
                             IsChecked="{Binding IsBasicString, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="String" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="→ IFunction&lt;String&gt;"
                                   FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton GroupName="fpType"
                             IsChecked="{Binding IsBasicInt, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Int" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="→ IFunction&lt;Int32&gt;"
                                   FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton GroupName="fpType"
                             IsChecked="{Binding IsBasicFloat, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Float" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="→ IFunction&lt;Single&gt;"
                                   FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton GroupName="fpType"
                             IsChecked="{Binding IsBasicBool, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Bool" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="→ IFunction&lt;Boolean&gt;"
                                   FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

            </StackPanel>

            <!-- ── Advanced type section ──────────────────────────── -->
            <Border Grid.Row="4"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#33FFFFFF"
                    Margin="0,0,0,14"
                    Padding="0,12,0,0">
                <StackPanel Spacing="8">

                    <RadioButton GroupName="fpType"
                                 IsChecked="{Binding IsAdvanced, Mode=TwoWay}">
                        <TextBlock Text="Advanced — pick any type"
                                   FontSize="13" FontWeight="SemiBold"/>
                    </RadioButton>

                    <!-- Advanced picker row — visible only when Advanced is selected -->
                    <Grid ColumnDefinitions="*,Auto"
                          IsVisible="{Binding AdvancedSectionVisible}"
                          Margin="24,0,0,0">
                        <Border Grid.Column="0"
                                Classes="dlg-list"
                                Padding="8,6"
                                CornerRadius="4"
                                Margin="0,0,8,0">
                            <TextBlock Text="{Binding AdvancedTypeName}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Opacity="0.85"/>
                        </Border>
                        <Button Grid.Column="1"
                                Content="Pick…"
                                Click="PickAdvancedType_Click"
                                Padding="12,6"
                                FontSize="12"/>
                    </Grid>

                    <!-- Resolved type preview for advanced selection -->
                    <TextBlock Text="{Binding ResolvedTypeName}"
                               IsVisible="{Binding AdvancedSectionVisible}"
                               Margin="24,0,0,0"
                               FontSize="11"
                               FontStyle="Italic"
                               Opacity="0.6"/>

                </StackPanel>
            </Border>

            <!-- ── OK / Cancel ────────────────────────────────────── -->
            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">
                <Button Content="{res:Localize Dialog_OK}"
                        Classes="dlg-primary"
                        Click="OK_Click"
                        IsDefault="True"
                        IsEnabled="{Binding CanOK}"
                        Padding="24,8"
                        MinWidth="80"/>
                <Button Content="{res:Localize Dialog_Cancel}"
                        Click="Cancel_Click"
                        IsCancel="True"
                        Padding="24,8"
                        MinWidth="80"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>

</Window>
