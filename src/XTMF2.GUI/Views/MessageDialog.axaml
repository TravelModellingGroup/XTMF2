<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:XTMF2.GUI.Views"
        xmlns:res="clr-namespace:XTMF2.GUI.Resources"
        x:Class="XTMF2.GUI.Views.MessageDialog"
        x:CompileBindings="True"
        x:DataType="local:MessageDialog"
        Width="450"
        Height="180"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    
    <Grid RowDefinitions="*,Auto" Margin="20">
        
        <!-- Message Content -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
            
            <!-- Icon -->
            <Viewbox Grid.Column="0" 
                     Width="48" 
                     Height="48"
                     Margin="0,0,15,0"
                     VerticalAlignment="Top">
                <Panel Width="24" Height="24">
                    <!-- Error Icon (Red X) -->
                    <Canvas Width="24" Height="24" 
                            IsVisible="{Binding IsError}"
                            Background="Transparent">
                        <Ellipse Width="24" Height="24" 
                                 Fill="#D32F2F"
                                 Canvas.Left="0" Canvas.Top="0"/>
                        <Path Data="M 7,7 L 17,17 M 17,7 L 7,17" 
                              Stroke="White" 
                              StrokeThickness="2"
                              StrokeLineCap="Round"/>
                    </Canvas>
                    
                    <!-- Warning Icon (Yellow Triangle) -->
                    <Canvas Width="24" Height="24" 
                            IsVisible="{Binding IsWarning}"
                            Background="Transparent">
                        <Path Data="M 12,2 L 22,20 L 2,20 Z" 
                              Fill="#FFA000"
                              Canvas.Left="0" Canvas.Top="0"/>
                        <Path Data="M 12,8 L 12,14 M 12,16 L 12,17" 
                              Stroke="White" 
                              StrokeThickness="2"
                              StrokeLineCap="Round"/>
                    </Canvas>
                    
                    <!-- Information Icon (Blue i) -->
                    <Canvas Width="24" Height="24" 
                            IsVisible="{Binding IsInformation}"
                            Background="Transparent">
                        <Ellipse Width="24" Height="24" 
                                 Fill="#1976D2"
                                 Canvas.Left="0" Canvas.Top="0"/>
                        <Path Data="M 12,7 L 12,8 M 12,10 L 12,17" 
                              Stroke="White" 
                              StrokeThickness="2"
                              StrokeLineCap="Round"/>
                    </Canvas>
                </Panel>
            </Viewbox>
            
            <!-- Message Text -->
            <TextBlock Grid.Column="1"
                       Text="{Binding Message}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
        </Grid>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,15,0,0">
            <Button Content="{res:Localize Dialog_OK}"
                    Click="OK_Click"
                    IsDefault="True"
                    Padding="20,8"
                    MinWidth="80"/>
        </StackPanel>
        
    </Grid>
    
</Window>
