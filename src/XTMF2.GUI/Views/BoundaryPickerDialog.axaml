<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:XTMF2.GUI.ViewModels"
        xmlns:local="clr-namespace:XTMF2.GUI.Views"
        x:Class="XTMF2.GUI.Views.BoundaryPickerDialog"
        x:CompileBindings="True"
        x:DataType="local:BoundaryPickerDialog"
        Classes="neon-dialog"
        Title="Boundaries"
        Width="480"
        Height="420"
        MinWidth="360"
        MinHeight="300"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="16">

        <!-- Instructions -->
        <TextBlock Grid.Row="0"
                   Text="Select a boundary to navigate to, or create a new child boundary below."
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <!-- Search box -->
        <TextBox Grid.Row="1"
                 x:Name="SearchBox"
                 Watermark="Search boundaries…"
                 Margin="0,0,0,8"/>

        <!-- Boundary list -->
        <Border Grid.Row="2"
                Classes="dlg-list">
            <ListBox x:Name="BoundaryListBox"
                     ItemsSource="{Binding BrowseItems}"
                     SelectedItem="{Binding SelectedBrowseItem, Mode=TwoWay}"
                     SelectionMode="Single"
                     DoubleTapped="BoundaryListBox_DoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:BoundaryBrowseItem">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Boundary.Name}"
                                       Margin="{Binding ItemMargin}"
                                       Padding="2"/>
                            <Button Grid.Column="1"
                                    Classes="dlg-danger"
                                    Click="DeleteBoundary_Click"
                                    IsVisible="{Binding CanDelete}"
                                    Padding="6,2"
                                    Margin="4,0,0,0"
                                    ToolTip.Tip="Delete boundary">
                                <PathIcon Width="14"
                                          Height="14"
                                          Foreground="{DynamicResource DlgDanger}"
                                          Data="M5,3 L9,3 L10,1 L14,1 L15,3 L19,3 L19,5 L17,5 L16,21 L8,21 L7,5 L5,5 Z M9,7 L9,18 L11,18 L11,7 Z M13,7 L13,18 L15,18 L15,7 Z"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Create new boundary section -->
        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="0,8,0,0"
                BorderBrush="{DynamicResource DlgSep}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         x:Name="NewBoundaryNameBox"
                         Watermark="New child boundary name…"
                         VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Create Under Selected"
                        Click="CreateBoundary_Click"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Dialog buttons -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,12,0,0">
            <Button Content="Go To Selected"
                    Classes="dlg-primary"
                    Click="Navigate_Click"
                    IsDefault="True"
                    Padding="16,8"
                    MinWidth="100"/>
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    IsCancel="True"
                    Padding="16,8"
                    MinWidth="80"/>
        </StackPanel>

    </Grid>

</Window>
