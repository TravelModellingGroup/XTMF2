<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:XTMF2.GUI.ViewModels"
             xmlns:ctrl="clr-namespace:XTMF2.GUI.Controls"
             xmlns:res="clr-namespace:XTMF2.GUI.Resources"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="XTMF2.GUI.Views.ModelSystemEditorView"
             x:DataType="vm:ModelSystemEditorViewModel"
             x:CompileBindings="True"
             Focusable="True">

    <!-- ── Per-theme colour tokens for the floating neon dock bar ──────── -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Dark">
                    <!-- pill shell -->
                    <SolidColorBrush x:Key="NeonPillBg">#E6050510</SolidColorBrush>
                    <SolidColorBrush x:Key="NeonPillBorder">#FF00D4FF</SolidColorBrush>
                    <!-- button text / icons -->
                    <SolidColorBrush x:Key="NeonPillFg">#FFEEFFFF</SolidColorBrush>
                    <!-- separator line -->
                    <SolidColorBrush x:Key="NeonPillSep">#4400D4FF</SolidColorBrush>
                    <!-- hover / press highlights -->
                    <SolidColorBrush x:Key="NeonPillHover">#2200D4FF</SolidColorBrush>
                    <SolidColorBrush x:Key="NeonPillPress">#4400D4FF</SolidColorBrush>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <!-- pill shell: white-tinted, slightly translucent -->
                    <SolidColorBrush x:Key="NeonPillBg">#F4F8FFEE</SolidColorBrush>
                    <SolidColorBrush x:Key="NeonPillBorder">#FF0066CC</SolidColorBrush>
                    <!-- button text / icons: dark navy -->
                    <SolidColorBrush x:Key="NeonPillFg">#FF003088</SolidColorBrush>
                    <!-- separator line -->
                    <SolidColorBrush x:Key="NeonPillSep">#550066CC</SolidColorBrush>
                    <!-- hover / press highlights -->
                    <SolidColorBrush x:Key="NeonPillHover">#1A0066CC</SolidColorBrush>
                    <SolidColorBrush x:Key="NeonPillPress">#330066CC</SolidColorBrush>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- BoxShadow cannot be set via DynamicResource (struct, no runtime type-conversion).
         Set via code-behind in UpdateThemeClass() using the x:Name on the Border. -->
    <UserControl.Styles>
        <Style Selector="Border.neon-pill">
            <Setter Property="BoxShadow" Value="0 0 14 3 #8000D4FF, 0 0 40 10 #4000A0FF, 0 6 24 0 #80000000"/>
        </Style>
    </UserControl.Styles>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveModelSystemCommand}"/>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+B" Command="{Binding BrowseBoundariesCommand}"/>
    </UserControl.KeyBindings>

    <Grid RowDefinitions="Auto,*" Margin="10">

        <!-- ── Header ──────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,8" ColumnDefinitions="*,Auto,Auto">
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Title}"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,2"/>
                <TextBlock Text="Model System Editor"
                           FontSize="13"
                           Opacity="0.6"/>
            </StackPanel>

            <!-- Boundary navigation dropdown -->
            <ComboBox x:Name="BoundaryNavComboBox"
                      Grid.Column="1"
                      ItemsSource="{Binding BoundaryNavigationItems}"
                      PlaceholderText="{Binding CurrentBoundaryLabel}"
                      Width="200"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"
                      ToolTip.Tip="Navigate to a boundary  (Ctrl+B)">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:BoundaryNavigationItem">
                        <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <AutoCompleteBox x:Name="NodeSearchBox"
                             Grid.Column="2"
                             ItemsSource="{Binding Nodes}"
                             MinimumPrefixLength="0"
                             FilterMode="ContainsOrdinal"
                             ValueMemberBinding="{Binding Name}"
                             Watermark="Find node…  (Ctrl+E)"
                             Width="220"
                             VerticalAlignment="Center"/>
        </Grid>

        <!-- ── Main content: full-width canvas with floating overlays ─────── -->
        <Panel Grid.Row="1">

            <!-- Canvas (fills the entire panel) -->
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True">
                <ScrollViewer x:Name="CanvasScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <ctrl:ModelSystemCanvas x:Name="TheCanvas"
                                            DataContext="{Binding}"/>
                </ScrollViewer>
            </Border>

            <!-- ── Floating action bar (bottom-centre, neon pill) ───────── -->
            <Border x:Name="NeonDockBar"
                    Classes="neon-pill"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20"
                    Padding="14,9"
                    CornerRadius="40"
                    Background="{DynamicResource NeonPillBg}"
                    BorderBrush="{DynamicResource NeonPillBorder}"
                    BorderThickness="1.5"
                    ZIndex="20">
                <StackPanel Orientation="Horizontal" Spacing="8">

                    <StackPanel.Styles>
                        <Style Selector="Separator">
                            <Setter Property="Width" Value="1"/>
                            <Setter Property="Height" Value="24"/>
                            <Setter Property="Background" Value="{DynamicResource NeonPillSep}"/>
                            <Setter Property="Margin" Value="4,0"/>
                        </Style>
                        <Style Selector="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource NeonPillFg}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="CornerRadius" Value="20"/>
                            <Setter Property="Padding" Value="10,6"/>
                        </Style>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource NeonPillHover}"/>
                        </Style>
                        <Style Selector="Button:pressed /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource NeonPillPress}"/>
                        </Style>
                        <Style Selector="Button:disabled">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Style>
                    </StackPanel.Styles>

                    <!-- Undo -->
                    <Button Command="{Binding UndoCommand}"
                            IsEnabled="{Binding CanUndo}"
                            ToolTip.Tip="Undo (Ctrl+Z)"
                            ToolTip.Placement="Top">
                        <TextBlock Text="&#x21B6;" FontSize="18" IsHitTestVisible="False"/>
                    </Button>

                    <!-- Redo -->
                    <Button Command="{Binding RedoCommand}"
                            IsEnabled="{Binding CanRedo}"
                            ToolTip.Tip="Redo (Ctrl+Y)"
                            ToolTip.Placement="Top">
                        <TextBlock Text="&#x21B7;" FontSize="18" IsHitTestVisible="False"/>
                    </Button>

                    <Separator/>

                    <!-- Save -->
                    <Button Command="{Binding SaveModelSystemCommand}"
                            ToolTip.Tip="{res:Localize ModelSystemEditor_SaveTooltip}"
                            ToolTip.Placement="Top">
                        <TextBlock Text="💾" FontSize="18" IsHitTestVisible="False"/>
                    </Button>

                    <!-- Export -->
                    <Button Command="{Binding ExportModelSystemCommand}"
                            ToolTip.Tip="{res:Localize ModelSystemEditor_ExportTooltip}"
                            ToolTip.Placement="Top">
                        <TextBlock Text="📤" FontSize="18" IsHitTestVisible="False"/>
                    </Button>

                    <!-- Revert -->
                    <Button Command="{Binding RevertModelSystemCommand}"
                            ToolTip.Tip="{res:Localize ModelSystemEditor_RevertTooltip}"
                            ToolTip.Placement="Top">
                        <TextBlock Text="↩" FontSize="18" IsHitTestVisible="False"/>
                    </Button>

                    <Separator/>

                    <!-- Run -->
                    <Button Command="{Binding RunModelSystemCommand}"
                            IsEnabled="{Binding CanRun}"
                            ToolTip.Tip="Run this model system (save first to apply changes)"
                            ToolTip.Placement="Top">
                        <TextBlock Text="▶" FontSize="18" IsHitTestVisible="False"/>
                    </Button>

                    <Separator/>

                    <!-- Variables -->
                    <Button Click="OnShowVariablesClick"
                            ToolTip.Tip="View / manage Model System Variables"
                            ToolTip.Placement="Top">
                        <TextBlock Text="⚙" FontSize="18" IsHitTestVisible="False"/>
                    </Button>

                </StackPanel>
            </Border>

        </Panel>

        <!-- ── Toast notification overlay ──────────────────────────────── -->
        <Border Grid.Row="1"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
                Padding="16,10"
                CornerRadius="6"
                IsVisible="{Binding ToastMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                IsHitTestVisible="False"
                ZIndex="100"
                Classes.error="{Binding ToastIsError}">
            <Border.Styles>
                <Style Selector="Border">
                    <Setter Property="Background" Value="#CC1565C0"/>
                </Style>
                <Style Selector="Border.error">
                    <Setter Property="Background" Value="#CCC62828"/>
                </Style>
            </Border.Styles>
            <TextBlock Text="{Binding ToastMessage}"
                       Foreground="White"
                       FontSize="13"
                       HorizontalAlignment="Center"/>
        </Border>

    </Grid>

</UserControl>

