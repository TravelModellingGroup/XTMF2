<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:XTMF2.GUI.Resources"
        xmlns:ctrl="clr-namespace:XTMF2.GUI.Controls"
        x:Class="XTMF2.GUI.Views.InterBoundaryLinkDialog"
        x:CompileBindings="False"
        Title="Link to Node in Another Boundary"
        Width="500"
        Height="480"
        MinWidth="380"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Grid RowDefinitions="*,Auto" Margin="16">

        <!-- Phase 1: select boundary -->
        <Grid Grid.Row="0"
              RowDefinitions="Auto,Auto,Auto,*"
              IsVisible="{Binding IsPhase1}">

            <TextBlock Grid.Row="0"
                       Text="{Binding Phase1Title}"
                       FontWeight="SemiBold"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4"/>

            <TextBlock Grid.Row="1"
                       Text="Choose the boundary that contains the destination module:"
                       FontSize="12"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4"/>

            <ctrl:SearchBox Grid.Row="2"
                            x:Name="BoundarySearchBox"
                            Text="{Binding BoundarySearchText, Mode=TwoWay}"
                            Watermark="Search boundaries…"
                            Margin="0,0,0,6"/>

            <Border Grid.Row="3"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <ListBox x:Name="BoundaryListBox"
                         ItemsSource="{Binding FilteredBoundaryItems}"
                         SelectedItem="{Binding SelectedBoundaryItem, Mode=TwoWay}"
                         SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Boundary.Name}"
                                       Margin="{Binding ItemMargin}"
                                       Padding="2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- Phase 2: select compatible node -->
        <Grid Grid.Row="0"
              RowDefinitions="Auto,Auto,Auto,Auto,*"
              IsVisible="{Binding IsPhase2}">

            <TextBlock Grid.Row="0"
                       Text="{Binding Phase2Title}"
                       FontWeight="SemiBold"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4"/>

            <TextBlock Grid.Row="1"
                       Text="{Binding Phase2Subtitle}"
                       FontSize="12"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4"/>

            <ctrl:SearchBox Grid.Row="2"
                            x:Name="NodeSearchBox"
                            Text="{Binding NodeSearchText, Mode=TwoWay}"
                            Watermark="Search modules…"
                            Margin="0,0,0,6"/>

            <!-- "No compatible modules" notice (shown when the boundary has no type-compatible nodes) -->
            <Border Grid.Row="3"
                    Background="{DynamicResource SystemControlHighlightListAccentLowBrush}"
                    CornerRadius="4"
                    Padding="10,6"
                    Margin="0,0,0,8"
                    IsVisible="{Binding NoCompatibleNodes}">
                <TextBlock Text="No compatible modules found in this boundary."
                           FontSize="12"
                           Opacity="0.85"
                           TextWrapping="Wrap"/>
            </Border>

            <Border Grid.Row="4"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsVisible="{Binding HasCompatibleNodes}">
                <ListBox x:Name="NodeListBox"
                         ItemsSource="{Binding FilteredNodes}"
                         SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                         SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="2" Margin="4,3">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>
                                <TextBlock Text="{Binding TypeDisplayName}"
                                           FontSize="11"
                                           Opacity="0.6"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">

            <!-- Phase 2 only: Back -->
            <Button Content="← Back"
                    Click="Back_Click"
                    IsVisible="{Binding IsPhase2}"
                    Padding="20,8"
                    MinWidth="70"/>

            <!-- Phase 1 only: Next -->
            <Button Content="Next →"
                    Click="Next_Click"
                    IsVisible="{Binding IsPhase1}"
                    IsEnabled="{Binding SelectedBoundaryItem, Converter={x:Static ObjectConverters.IsNotNull}}"
                    IsDefault="True"
                    Padding="20,8"
                    MinWidth="70"/>

            <!-- Phase 2 only: Link -->
            <Button Content="Link"
                    Click="Link_Click"
                    IsVisible="{Binding IsPhase2}"
                    IsDefault="True"
                    IsEnabled="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Padding="20,8"
                    MinWidth="70"/>

            <!-- Always: Cancel -->
            <Button Content="{res:Localize Dialog_Cancel}"
                    Click="Cancel_Click"
                    IsCancel="True"
                    Padding="20,8"
                    MinWidth="70"/>

        </StackPanel>

    </Grid>
</Window>
