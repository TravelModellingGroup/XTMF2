<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:XTMF2.GUI.Resources"
        xmlns:local="clr-namespace:XTMF2.GUI.Views"
        x:Class="XTMF2.GUI.Views.LinkDestinationOrderDialog"
        x:CompileBindings="True"
        x:DataType="local:LinkDestinationOrderDialog"
        Classes="neon-dialog"
        Title="Reorder Link Destinations"
        Width="460"
        Height="380"
        MinWidth="360"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- Prompt -->
        <TextBlock Grid.Row="0"
                   Text="Drag rows or use the buttons to change the destination order:"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <!-- List + Up/Down buttons -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

            <Border Grid.Column="0" Classes="dlg-list">
                <ListBox x:Name="DestListBox"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         SelectionMode="Single"
                         PointerPressed="OnListPointerPressed"
                         PointerMoved="OnListPointerMoved"
                         PointerReleased="OnListPointerReleased"
                         PointerCaptureLost="OnListPointerCaptureLost">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:DestinationOrderItem">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,4">
                                <!-- Drag handle -->
                                <TextBlock Text="⠿"
                                           FontSize="14"
                                           Opacity="0.45"
                                           VerticalAlignment="Center"
                                           Cursor="SizeNorthSouth"
                                           Margin="0,0,2,0"
                                           ToolTip.Tip="Drag to reorder"/>
                                <!-- Position badge -->
                                <Border Background="{DynamicResource DlgAccentDim}"
                                        CornerRadius="10"
                                        Padding="6,2"
                                        MinWidth="28"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayIndex}"
                                               FontSize="11"
                                               TextAlignment="Center"
                                               Opacity="0.85"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <!-- Destination node name -->
                                <TextBlock Text="{Binding Name}"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Move buttons -->
            <StackPanel Grid.Column="1"
                        Spacing="8"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">
                <Button Content="▲  Up"
                        Click="MoveUp_Click"
                        MinWidth="84"
                        Padding="10,6"
                        IsEnabled="{Binding CanMoveUp}"/>
                <Button Content="▼  Down"
                        Click="MoveDown_Click"
                        MinWidth="84"
                        Padding="10,6"
                        IsEnabled="{Binding CanMoveDown}"/>
            </StackPanel>

        </Grid>

        <!-- OK / Cancel -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,12,0,0">
            <Button Content="{res:Localize Dialog_OK}"
                    Classes="dlg-primary"
                    Click="OK_Click"
                    IsDefault="True"
                    Padding="20,8"
                    MinWidth="80"/>
            <Button Content="{res:Localize Dialog_Cancel}"
                    Click="Cancel_Click"
                    IsCancel="True"
                    Padding="20,8"
                    MinWidth="80"/>
        </StackPanel>

    </Grid>
</Window>
