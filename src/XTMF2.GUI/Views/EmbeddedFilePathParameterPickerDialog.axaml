<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:XTMF2.GUI.Views"
        x:Class="XTMF2.GUI.Views.EmbeddedFilePathParameterPickerDialog"
        x:CompileBindings="True"
        x:DataType="local:EmbeddedFilePathParameterPickerDialog"
        Classes="neon-dialog"
        Title="Select Parameter"
        Width="460"
        Height="340"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <TextBlock Grid.Row="0"
                   Text="{Binding Prompt}"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <Border Grid.Row="1" Classes="dlg-list">
            <ListBox x:Name="ParameterListBox"
                     ItemsSource="{Binding Choices}"
                     SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:EmbeddedFilePathParameterChoice">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="13"
                                   Margin="4,5"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,12,0,0">
            <Button Content="Select"
                    Classes="dlg-primary"
                    Click="Select_Click"
                    IsDefault="True"
                    Padding="24,8"
                    MinWidth="80"/>
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    IsCancel="True"
                    Padding="24,8"
                    MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>
