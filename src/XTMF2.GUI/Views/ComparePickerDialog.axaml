<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xtmf2="clr-namespace:XTMF2;assembly=XTMF2"
        xmlns:local="clr-namespace:XTMF2.GUI.Views"
        x:Class="XTMF2.GUI.Views.ComparePickerDialog"
        x:CompileBindings="False"
        Classes="neon-dialog"
        Title="Compare Model System"
        Width="480"
        Height="380"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20">

        <!-- Prompt -->
        <TextBlock Grid.Row="0"
                   Text="Select the model system to compare against:"
                   FontSize="14"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"/>

        <!-- Project model systems list -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource DlgListBorder}"
                BorderThickness="1"
                CornerRadius="4">
            <ListBox x:Name="ModelSystemListBox"
                     ItemsSource="{Binding OtherModelSystems}"
                     SelectedItem="{Binding SelectedModelSystem, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="xtmf2:ModelSystemHeader">
                        <StackPanel Margin="8,6">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Description}"
                                       FontSize="12"
                                       Opacity="0.6"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Browse for exported file -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource DlgSep}"
                BorderThickness="0,1,0,0"
                Margin="0,10,0,0"
                Padding="0,10,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           x:Name="SelectedFileText"
                           Text="— or browse for an exported .xmsf file —"
                           FontSize="12"
                           Opacity="0.55"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1"
                        Content="Browse…"
                        Padding="12,6"
                        Margin="10,0,0,0"
                        Click="BrowseFile_Click"/>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,14,0,0">
            <Button Content="Compare"
                    Classes="dlg-primary"
                    Click="Compare_Click"
                    IsDefault="True"
                    Padding="20,8"
                    MinWidth="80"/>
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    IsCancel="True"
                    Padding="20,8"
                    MinWidth="80"/>
        </StackPanel>

    </Grid>

</Window>
