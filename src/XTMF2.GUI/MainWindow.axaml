<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:XTMF2.GUI.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="XTMF2.GUI.MainWindow"
        Title="XTMF2"
        Width="1200"
        Height="700">
    <Grid>
        <TabControl x:Name="MainTabControl"
                    TabStripPlacement="Top">
            
            <!-- Start Page Tab -->
            <TabItem Header="Start" x:Name="StartTab">
                <views:ProjectsView x:Name="ProjectsViewControl" />
            </TabItem>
            
        </TabControl>
        
        <!-- Settings Button -->
        <Button Content="⚙ Settings"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,15,0"
                Padding="12,6"
                Click="Settings_Click"
                x:Name="SettingsButton"/>
        
        <!-- Loading Overlay -->
        <Border x:Name="LoadingPanel"
                Background="#CC000000"
                IsVisible="True">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="20"
                        Width="300">
                
                <TextBlock Text="Loading XTMF2..."
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="White"/>
                
                <ProgressBar IsIndeterminate="True"
                             Height="4"/>
                
                <TextBlock Text="Initializing runtime and loading projects"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="#CCFFFFFF"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
                
            </StackPanel>
        </Border>
    </Grid>
</Window>
