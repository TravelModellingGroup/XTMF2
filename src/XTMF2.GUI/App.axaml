<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:XTMF2.GUI.ViewModels"
             xmlns:views="clr-namespace:XTMF2.GUI.Views"
             x:Class="XTMF2.GUI.App"
             RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <!-- ItemsSource dock template: ProjectsViewModel -> ProjectsView -->
        <DataTemplate DataType="vm:ProjectsViewModel">
            <views:ProjectsView />
        </DataTemplate>
        <!-- ItemsSource dock template: ModelSystemsViewModel -> ModelSystemsView -->
        <DataTemplate DataType="vm:ModelSystemsViewModel">
            <views:ModelSystemsView />
        </DataTemplate>
        <!-- ItemsSource dock template: ModelSystemEditorViewModel -> ModelSystemEditorView -->
        <DataTemplate DataType="vm:ModelSystemEditorViewModel">
            <views:ModelSystemEditorView />
        </DataTemplate>
        <!-- ItemsSource dock template: RunsViewModel -> RunsView -->
        <DataTemplate DataType="vm:RunsViewModel">
            <views:RunsView />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            
            <!-- Forest Green Theme Colors -->
            <ResourceDictionary x:Key="ForestGreen">
                <Color x:Key="AccentColor">#2D5016</Color>
                <Color x:Key="AccentColorLight">#4A7C2C</Color>
                <Color x:Key="AccentColorDark">#1A3009</Color>
            </ResourceDictionary>
            
            <!-- Ruby Red Theme Colors -->
            <ResourceDictionary x:Key="RubyRed">
                <Color x:Key="AccentColor">#9B111E</Color>
                <Color x:Key="AccentColorLight">#C41E3A</Color>
                <Color x:Key="AccentColorDark">#6B0C15</Color>
            </ResourceDictionary>
            
            <!-- Sapphire Blue Theme Colors -->
            <ResourceDictionary x:Key="SapphireBlue">
                <Color x:Key="AccentColor">#0F52BA</Color>
                <Color x:Key="AccentColorLight">#4169E1</Color>
                <Color x:Key="AccentColorDark">#0A3A82</Color>
            </ResourceDictionary>
        </ResourceDictionary>
    </Application.Resources>
    
    <Application.Styles>
        <FluentTheme DensityStyle="Compact" />
        <DockFluentTheme />
        
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style Selector="TabControl">
            <Setter Property="Background" Value="{DynamicResource SystemChromeMediumColor}"/>
        </Style>
        
        <!-- Forest Green Theme Styles -->
        <Style Selector=":is(Button).forest-green">
            <Setter Property="Background" Value="#4A7C2C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector=":is(Button).forest-green:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#5A8C3C"/>
        </Style>
        
        <!-- Ruby Red Theme Styles -->
        <Style Selector=":is(Button).ruby-red">
            <Setter Property="Background" Value="#C41E3A"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector=":is(Button).ruby-red:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#D42E4A"/>
        </Style>
        
        <!-- Sapphire Blue Theme Styles -->
        <Style Selector=":is(Button).sapphire-blue">
            <Setter Property="Background" Value="#4169E1"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector=":is(Button).sapphire-blue:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#5179F1"/>
        </Style>
        
    </Application.Styles>
</Application>
